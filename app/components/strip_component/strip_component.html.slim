h3
  button type="button" class=classes disabled=true aria-expanded="true" aria-controls=body_id data-kind=step.kind data-gate=step.gate?.to_s data-playback-target="strip" data-action="playback#select"
    span> class="flex w-step-number shrink-0 items-center justify-center self-stretch border-r border-rule text-label text-quiet" = number
    span> class="min-w-0 flex-1 px-2 py-1.5 text-strip font-medium wrap-anywhere" = step.name
    span> class="flex w-step-control shrink-0 flex-col justify-center self-stretch border-l border-rule px-2 text-cell uppercase"
      span> class="text-quiet" Ctl
      span = lane
    span> class="flex w-step-bay shrink-0 flex-col justify-center self-stretch border-l border-rule px-2 text-cell uppercase"
      span> class="text-quiet" Bay
      span = step.bay
    span> class=status_classes data-playback-target="status"
    span class="flex basis-full border-t border-rule py-0.5 in-data-[state=pending]:hidden in-data-[state=active]:hidden"
      span class="w-step-number shrink-0" aria-hidden="true"
      span class="px-2"
        span> class="text-cell uppercase text-quiet" Rmk
        = step.outcome
    / The active step's remaining time, emptying left to right; frozen while paused.
    span class="pointer-events-none absolute inset-x-0 bottom-0 hidden origin-right border-b-2 border-ink animate-remaining [animation-play-state:paused] in-data-[state=active]:block in-data-playing:[animation-play-state:running]" aria-hidden="true" data-playback-target="line"
