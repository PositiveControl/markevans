div class="flex flex-col gap-6 print:gap-1"
  - sections.each do |section|
    section class="flex flex-col gap-3 print:gap-1"
      h2 class="border-b border-rule pb-1 font-mono text-label uppercase text-quiet print:pb-0 print:text-print-label" = section.heading
      - section.paragraphs.each do |paragraph|
        p class="max-w-measure font-serif print:text-print-prose" = paragraph
      - section.groups.each do |group|
        = render DetailGroupComponent.new(group:, level: 3)
