div class="flex gap-1" hidden=true data-playback-target="live"
  - CONTROLS.each do |control|
    - if control.icon
      button type="button" class=classes(control) aria-label=control.label data-action="playback##{control.action}"
        svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          - control.icon.each do |path|
            path d=path
    - else
      button type="button" class=classes(control) aria-label=control.label data-playback-target="play" data-action="playback##{control.action}"
        svg class="block in-data-playing:hidden" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"
          path d=PLAY
        svg class="hidden in-data-playing:block" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
          - PAUSE.each do |path|
            path d=path
