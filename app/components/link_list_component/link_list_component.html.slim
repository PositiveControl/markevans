/ The group carries the name: a dl has no role an accessible name is announced on.
div role="group" aria-label=label
  dl class="flex max-w-detail flex-col print:max-w-none"
    - links.each do |link|
      div class="flex flex-wrap items-center gap-x-4 border-b border-rule"
        dt class="w-row-key max-w-full shrink-0 font-mono text-key print:w-print-key print:text-print-key" = link.label
        dd class="min-w-0 flex-1 font-mono text-key wrap-anywhere print:text-print-key"
          - if link.placeholder?
            span class="inline-flex min-h-8 items-center text-quiet print:min-h-0" = link.url
          - else
            a class="inline-flex min-h-8 items-center underline underline-offset-4 print:min-h-0" href=link.url = shown(link)
