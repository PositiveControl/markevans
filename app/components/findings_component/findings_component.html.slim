/ The heading is PageSectionsComponent's, so Findings reads as one of the
/ project's sections.
section class="flex flex-col gap-3"
  h2#findings-heading class="border-b border-rule pb-1 font-mono text-label uppercase text-quiet" Findings
  ul class="flex flex-col gap-6" aria-labelledby="findings-heading"
    - findings.each.with_index(1) do |finding, n|
      li class="flex max-w-measure flex-col gap-1" id="finding-#{n}" data-kind=finding.kind
        p class="flex items-center gap-1 font-mono text-label uppercase"
          = render FindingMarkComponent.new(kind: finding.kind)
          = finding.kind.capitalize
        h3 class="font-serif font-medium" = finding.title
        p class="font-serif" = finding.body
        - if (evidence = finding.evidence)
          p class="font-mono text-key wrap-anywhere"
            - if evidence.placeholder?
              span class="inline-flex min-h-8 items-center text-quiet" = "#{evidence.label} #{evidence.url}"
            - else
              a class="inline-flex min-h-8 items-center underline underline-offset-4" href=evidence.url = evidence.label
