/ The roll-up (design doc, section 6): grid rows ease between 1fr and 0fr, and
/ a closed body is invisible, so it leaves the tab order. Open without scripts.
div id=body_id class="grid grid-rows-[1fr] transition-[grid-template-rows,visibility] duration-200 ease-out motion-reduce:transition-none in-data-settling:transition-none in-data-[open=false]:invisible in-data-[open=false]:grid-rows-[0fr] in-data-dim:text-quiet"
  div class="min-h-0 overflow-hidden"
    div class="flex flex-col gap-4 px-2 pt-3 pb-5"
      p class="max-w-measure font-serif" = step.body
      - step.groups.each do |group|
        = render DetailGroupComponent.new(group:)
      - if step.artifact
        div class="max-w-artifact rounded-box border border-rule bg-card font-mono text-artifact"
          div class="border-b border-rule px-2 py-1 text-label text-quiet wrap-anywhere"
            - if step.artifact.url
              a class="underline underline-offset-4" href=step.artifact.url = step.artifact.source
            - else
              = step.artifact.source
          pre class="overflow-x-auto p-2 font-mono whitespace-pre-wrap" = step.artifact.body
      - if step.note
        p class="max-w-measure font-serif italic" = step.note
