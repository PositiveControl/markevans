/ /work: the projects in content/work.yml, under their categories in
/ Portfolio::CATEGORIES order and in the file's order within each, under the
/ copy in content/pages/work.yml (docs/system/site-pages.md).
- content_for :title, "#{@page.title} · Mark Evans"
- content_for :meta_description, @page.description.truncate(155, separator: " ")
- content_for(:canonical_url) { projects_url }
- content_for(:head) { jsonld_tag(project_list_jsonld(@page, @groups.flat_map(&:last))) }

main class="mx-auto max-w-page px-3 pt-6 pb-16 chart:px-8"
  h1 class="text-headline" = @page.title
  p class="mt-4 max-w-measure" = @page.intro
  div class="mt-6 max-w-detail"
    = render StackFilterComponent.new(tags: Portfolio.tags, current: @tag)
  - @groups.each do |category, projects|
    section class="mt-8 flex max-w-detail flex-col gap-2"
      h2 class="font-mono text-label uppercase text-quiet" = category
      ul class="flex flex-col" aria-label=category
        - projects.each do |project|
          li class="flex flex-col gap-2 border-b border-rule py-3 first:border-t chart:flex-row chart:items-start chart:justify-between chart:gap-4" data-project=project.key
            a class="flex min-h-8 flex-col gap-1 no-underline" href=project_path(project.key)
              span class="font-mono text-strip font-medium underline underline-offset-4" = project.name
              span class="font-serif text-ink" = project.summary
            - if project.tags.any?
              ul class="flex flex-wrap gap-1 chart:w-1/3 chart:shrink-0 chart:justify-end" aria-label="Stack"
                - project.tags.each do |tag|
                  = render ChipComponent.new(name: tag)

= render SiteFooterComponent.new
