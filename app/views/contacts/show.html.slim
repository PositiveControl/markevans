/ /contact: the ways to reach Mark, from content/pages/contact.yml
/ (docs/system/site-pages.md). An address still to be supplied shows as its
/ [placeholder], not as a link.
- content_for :title, "#{@page.title} · Mark Evans"
- content_for :meta_description, @page.description.truncate(155, separator: " ")
- content_for(:canonical_url) { contact_url }
- content_for(:head) { jsonld_tag(web_page_jsonld(type: "ContactPage", name: @page.title, description: @page.description, url: contact_url)) }

main class="mx-auto max-w-page px-3 pt-6 pb-16 chart:px-8"
  h1 class="text-headline" = @page.title
  p class="mt-4 max-w-measure" = @page.intro
  div class="mt-6"
    = render LinkListComponent.new(links: @page.links, label: "Contact routes")
  div class="mt-8"
    = render PageSectionsComponent.new(sections: @page.sections)

= render SiteFooterComponent.new
