/# locals: (profile:)
- mailto = "mailto:#{profile.email}"
- github_label = profile.github.delete_prefix("https://")
- linkedin_label = profile.linkedin.delete_prefix("https://").delete_prefix("www.")
- tagline_head, _, tagline_tail = profile.tagline.rpartition(" ")
ruby:
  meta_rows = [
    [ "role",   profile.role,                                                "text-mid" ],
    [ "based",  profile.location,                                            "text-mid" ],
    [ "since",  "#{profile.started} (#{Portfolio.years_shipping} years)",    "text-mid" ],
    [ "status", profile.availability,                                        "text-amber" ]
  ]
section#top class="px-6 pt-32 pb-20 sm:pt-40 sm:pb-28" data-controller="reveal" data-reveal-visible-class="reveal-in" aria-labelledby="hero-heading"
  .mx-auto.max-w-5xl
    p class="reveal font-mono text-xs font-medium tracking-[0.25em] text-amber uppercase" data-reveal-target="item"
      = profile.role
    h1#hero-heading class="reveal mt-6 font-mono text-5xl font-semibold tracking-tight text-fg sm:text-7xl" data-reveal-target="item" style="--reveal-delay: 40ms"
      = profile.name
    / The caret is the page's one piece of decoration. It stops for
    / prefers-reduced-motion. It hangs off the last word rather than the
    / paragraph so it can never wrap onto a line of its own.
    p class="reveal mt-6 max-w-2xl font-mono text-lg leading-snug text-mid sm:text-2xl" data-reveal-target="item" style="--reveal-delay: 90ms"
      = "#{tagline_head} "
      span class="caret whitespace-nowrap"
        = tagline_tail
    p class="reveal mt-8 max-w-2xl text-base leading-7 text-mid" data-reveal-target="item" style="--reveal-delay: 140ms"
      = profile.summary

    .reveal.mt-10.flex.flex-wrap.items-center.gap-x-8.gap-y-3.font-mono.text-sm data-reveal-target="item" style="--reveal-delay: 190ms"
      a class="text-fg underline decoration-rule underline-offset-4 transition-colors hover:text-amber hover:decoration-amber" href=mailto
        = profile.email
      a class="text-fg underline decoration-rule underline-offset-4 transition-colors hover:text-amber hover:decoration-amber" href=profile.github rel="noopener" target="_blank"
        = github_label
      a class="text-fg underline decoration-rule underline-offset-4 transition-colors hover:text-amber hover:decoration-amber" href=profile.linkedin rel="noopener" target="_blank"
        = linkedin_label

    dl class="reveal mt-14 grid max-w-2xl gap-x-8 gap-y-2.5 border-t border-rule-soft pt-8 font-mono text-sm sm:grid-cols-[7rem_1fr]" data-reveal-target="item" style="--reveal-delay: 240ms"
      - meta_rows.each do |key, value, value_class|
        dt class="text-dim"
          = key
        dd class=value_class
          = value
