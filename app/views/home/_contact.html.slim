/# locals: (profile:)
- year = Date.current.year
ruby:
  contact_rows = [
    [ "email",    profile.email,                                                    "mailto:#{profile.email}", false ],
    [ "github",   profile.github.delete_prefix("https://"),                         profile.github,            true ],
    [ "linkedin", profile.linkedin.delete_prefix("https://").delete_prefix("www."), profile.linkedin,          true ]
  ]
section#contact class="border-t border-rule-soft px-6 py-20" data-controller="reveal" data-reveal-visible-class="reveal-in" aria-labelledby="contact-heading"
  .mx-auto.max-w-5xl
    = render "home/section_heading", id: "contact", label: "Contact"
    .reveal.mt-8.max-w-2xl data-reveal-target="item"
      p class="text-lg leading-8 text-fg"
        | Senior and staff roles, Rails and applied AI, remote or Phoenix. If you have a system that
          has to work on a Saturday night, that is the conversation I want.
      dl class="mt-10 grid gap-x-8 gap-y-3 border-t border-rule-soft pt-8 font-mono text-sm sm:grid-cols-[7rem_1fr]"
        - contact_rows.each do |label, text, href, external|
          dt class="text-dim"
            = label
          dd
            a class="text-fg underline decoration-rule underline-offset-4 transition-colors hover:text-amber hover:decoration-amber" href=href rel=(external ? "noopener" : nil) target=(external ? "_blank" : nil)
              = text

footer class="border-t border-rule-soft px-6 py-8"
  .mx-auto.flex.max-w-5xl.flex-wrap.items-center.justify-between.gap-3.font-mono.text-xs.text-dim
    p
      | © #{year} #{profile.name}
    p Rails 8, Hotwire, Tailwind, Kamal
