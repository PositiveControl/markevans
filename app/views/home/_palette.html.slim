/# locals: (profile:, projects:)
/ Command palette — ⌘K / Ctrl+K, or "/" when the caret is not in a field.
/ Every row is rendered server-side; palette_controller.js only filters and
/ highlights them.
ruby:
  entries = [
    { label: "Impact",   meta: "section", href: "#impact" },
    { label: "Work",     meta: "section", href: "#work" },
    { label: "Projects", meta: "section", href: "#projects" },
    { label: "Skills",   meta: "section", href: "#skills" },
    { label: "Contact",  meta: "section", href: "#contact" }
  ]
  entries += projects.map do |project|
    { label: project.name, meta: project.link_label, href: project.url, external: true }
  end
  entries += [
    { label: "GitHub",   meta: profile.github.delete_prefix("https://"), href: profile.github, external: true },
    { label: "LinkedIn", meta: profile.linkedin.delete_prefix("https://").delete_prefix("www."), href: profile.linkedin, external: true },
    { label: "Email Mark", meta: profile.email, href: "mailto:#{profile.email}" },
    { label: "Copy email address", meta: profile.email, copy: profile.email }
  ]

  # The transparent left border is always there so adding the amber one to the
  # active row (data-palette-active-class) shifts nothing.
  row_class = "flex w-full items-baseline justify-between gap-6 border-l-2 border-transparent px-4 py-2.5 text-left font-mono text-sm text-mid transition-colors hover:bg-raised hover:text-fg"
  meta_class = "shrink-0 truncate font-mono text-xs text-dim"

div class="fixed inset-0 z-50 flex items-start justify-center bg-ink/85 px-4 pt-[10vh] backdrop-blur-sm" hidden=true role="dialog" aria-modal="true" aria-label="Command palette" data-palette-target="dialog" data-action="keydown->palette#dialogKeys click->palette#backdrop"
  / The panel sits on --color-ink so the highlighted row (bg-raised, set from
  / data-palette-active-class) is the lighter surface and actually reads.
  div class="w-full max-w-xl border border-rule bg-ink"
    .flex.items-center.gap-3.border-b.border-rule.px-4
      span class="font-mono text-sm text-amber" aria-hidden="true" ›
      label class="sr-only" for="palette-query"
        | Search sections, projects and links
      input#palette-query class="w-full bg-transparent py-3.5 font-mono text-sm text-fg outline-none placeholder:text-dim" type="text" autocomplete="off" spellcheck="false" placeholder="jump to" role="combobox" aria-expanded="true" aria-controls="palette-results" data-palette-target="input" data-action="input->palette#filter"

    div#palette-results class="max-h-80 overflow-y-auto py-2" role="listbox" aria-label="Palette results"
      - entries.each_with_index do |entry, index|
        - item_id = "palette-item-#{index}"
        - search = "#{entry[:label]} #{entry[:meta]}".downcase
        - if entry[:copy]
          button id=item_id class=row_class type="button" role="option" aria-selected="false" data-palette-target="item" data-palette-label=search data-palette-copy=entry[:copy] data-action="click->palette#copy"
            span data-palette-target="copyLabel"
              = entry[:label]
            span class=meta_class
              = entry[:meta]
        - else
          a id=item_id class=row_class role="option" aria-selected="false" href=entry[:href] rel=(entry[:external] ? "noopener" : nil) target=(entry[:external] ? "_blank" : nil) data-palette-target="item" data-palette-label=search data-action="click->palette#close"
            span
              = entry[:label]
            span class=meta_class
              = entry[:meta]

      p class="px-4 py-6 font-mono text-sm text-dim" hidden=true data-palette-target="empty"
        | no match

    / py-2.5 cannot go in the dot shorthand: Slim splits it into "py-2" and "5".
    div class="flex flex-wrap items-center gap-x-5 gap-y-1 border-t border-rule px-4 py-2.5 font-mono text-[0.7rem] text-dim"
      span ↑↓ move
      span ⏎ open
      span esc close
