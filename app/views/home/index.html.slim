- profile = Portfolio.profile
- projects = Portfolio.projects
- page_title = "#{profile.name} — #{profile.role}"
- content_for :title, page_title
- content_for :meta_description, profile.summary.truncate(155)

- content_for :head do
  ruby:
    person = {
      "@context" => "https://schema.org",
      "@type" => "Person",
      "name" => profile.name,
      "jobTitle" => profile.role,
      "email" => "mailto:#{profile.email}",
      "url" => root_url,
      "address" => { "@type" => "PostalAddress", "addressLocality" => "Phoenix", "addressRegion" => "AZ" },
      "sameAs" => [ profile.github, profile.linkedin ],
      "knowsAbout" => Portfolio.skill_groups.flat_map(&:items).first(12)
    }
  = jsonld_tag(person)

/ The nav's ⌘K button and the palette dialog share one controller element.
/ keydown@window is how the shortcut is heard wherever the caret happens to be.
div data-controller="palette" data-action="keydown@window->palette#hotkey" data-palette-active-class="bg-raised border-amber text-fg"
  = render "home/nav", profile: profile
  = render "home/palette", profile: profile, projects: projects

main
  = render "home/hero", profile: profile
  = render "home/metrics", metrics: Portfolio.metrics
  = render "home/work", roles: Portfolio.roles
  = render "home/projects", projects: projects
  = render "home/skills", groups: Portfolio.skill_groups
  = render "home/contact", profile: profile
