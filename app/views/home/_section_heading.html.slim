/# locals: (id:, label:, count: nil, note: nil)
- heading_id = "#{id}-heading"
header
  .flex.items-baseline.gap-4
    h2 id=heading_id class="font-mono text-xs font-medium tracking-[0.25em] text-amber uppercase"
      = label
    span class="h-px flex-1 bg-rule-soft" aria-hidden="true"
    - if count
      span class="shrink-0 font-mono text-xs text-dim"
        = count
  - if note
    p class="mt-4 max-w-2xl text-sm leading-6 text-dim"
      = note
