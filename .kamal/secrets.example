# Copy to .kamal/secrets (gitignored) and fill in. Never commit real values.
# Every secret config/deploy.yml declares must be defined here, or Kamal stops.

# GitHub PAT (classic) with write:packages, read:packages — same kind dopeempire uses
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Decrypts config/credentials.yml.enc
RAILS_MASTER_KEY=$(cat config/master.key)

# Password for the markevans-db accessory. Generate once: openssl rand -hex 32
# Postgres keeps the password it first started with; changing it here later
# doesn't change the database's.
POSTGRES_PASSWORD=$MARKEVANS_POSTGRES_PASSWORD

# The app reaches the accessory by container name on the kamal network.
# One database per role, all built from the one password; the entrypoint
# creates them on first boot. Don't point them at one database — see the
# note in config/deploy.yml. ${POSTGRES_PASSWORD} reads the line above, so
# however you fill that in, the URLs follow. An unset variable expands to
# nothing, and the app then fails with "fe_sendauth: no password supplied".
DATABASE_URL=postgres://markevans:${POSTGRES_PASSWORD}@markevans-db:5432/markevans_production
QUEUE_DATABASE_URL=postgres://markevans:${POSTGRES_PASSWORD}@markevans-db:5432/markevans_production_queue
CABLE_DATABASE_URL=postgres://markevans:${POSTGRES_PASSWORD}@markevans-db:5432/markevans_production_cable
CACHE_DATABASE_URL=postgres://markevans:${POSTGRES_PASSWORD}@markevans-db:5432/markevans_production_cache
